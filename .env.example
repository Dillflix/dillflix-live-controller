# Demo schedules and a persistent simulated device by default.
CONTROLLER_MODE=demo
# Set CONTROLLER_MODE=teamarr and supply the reachable root URL of your fork.
# Inside a container, localhost refers to the controller container itself.
TEAMARR_URL=http://teamarr:9195
TEAMARR_TOKEN=
FEED_INTERVAL_SECONDS=60
STATUS_INTERVAL_SECONDS=15
NAVIGATION_TIMEOUT_SECONDS=120
PLAYBACK_RECOVERY_GRACE_SECONDS=60
JOB_HISTORY_LIMIT=1000
COMMAND_HISTORY_LIMIT=10000
CATALOG_RETENTION_DAYS=30

# Optional live screen. Blank disables capture. Use the serial shown by adb devices.
# For a network Fire TV, set its stable IP and ADB port, e.g. 192.168.1.50:5555.
SCREEN_ADB_SERIAL=
SCREEN_MAX_SIZE=1280
SCREEN_MAX_FPS=30
SCREEN_BIT_RATE=2000000
# Local Python installs only; Docker installs this at /opt automatically.
# SCREEN_SERVER_PATH=data/scrcpy-server-v3.3.4
# SCREEN_ADB_PATH=adb

# Listen on the host's LAN interfaces so another PC can reach http://HOST_IP:8790.
# Set 127.0.0.1 when using a host-local authenticated nginx reverse proxy only.
CONTROLLER_BIND_ADDRESS=0.0.0.0
CONTROLLER_PORT=8790

# Real autonomous playback is opt-in and requires CONTROLLER_MODE=teamarr.
# Uses the same configured SCREEN_ADB_SERIAL and persistent ADB identity.
PLAYBACK_ADAPTER=simulator
# New Prime Player workflow: see docs/prime-player.md for activation status.
# The service already runs on the host; the controller never starts/restarts it.
PRIME_PLAYER_SOCKET=
PRIME_PLAYER_SOCKET_DIRECTORY=
PRIME_PLAYER_MATCH_MODEL=
PRIME_PLAYER_SEARCH_TIMEOUT_SECONDS=100
PRIME_PLAYER_STATUS_TIMEOUT_SECONDS=10
# With prime-player, set NAVIGATION_TIMEOUT_SECONDS=300 above.
# Set to prime-video after configuring your vision service below.
EXECUTOR_LLM_BASE_URL=
EXECUTOR_LLM_API_KEY=
# Use your endpoint's exact served model names. Both must accept image inputs.
EXECUTOR_ACTOR_MODEL=
EXECUTOR_OBSERVER_MODEL=
EXECUTOR_ACTOR_PROTOCOL=json
# json or tvtheseus for the actor; the observer always returns validated JSON.
EXECUTOR_STRUCTURED_OUTPUT=json_schema
# Use json_object only if your inference server lacks json_schema support.
# Optional self-hosted settings, e.g. {"temperature":0,"top_p":0.8,"top_k":20,"min_p":0,"presence_penalty":0,"repetition_penalty":1,"chat_template_kwargs":{"enable_thinking":false}}
EXECUTOR_LLM_OPTIONS_JSON=
# External API credential (32+ random characters). Blank disables external executor
# API access; the built-in controller integration still works.
EXECUTOR_API_TOKEN=
EXECUTOR_MODEL_TIMEOUT_SECONDS=45
EXECUTOR_ADB_TIMEOUT_SECONDS=10
EXECUTOR_CANCEL_TIMEOUT_SECONDS=20
EXECUTOR_MONITOR_INTERVAL_SECONDS=5
# Read the already-installed dev.tvprobe.mediasession service from the exploration.
EXECUTOR_MEDIA_PROBE=true
EXECUTOR_RUNTIME_MAX_AGE_SECONDS=15
EXECUTOR_VISUAL_MONITOR_INTERVAL_SECONDS=30
EXECUTOR_COMPLETION_INTERVAL_SECONDS=15
EXECUTOR_MAX_ACTIONS=30
EXECUTOR_SETTLE_SECONDS=1
